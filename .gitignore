# Dependencies
node_modules/

# WhatsApp session/auth state — losing these forces a re-pair; leaking them
# is equivalent to leaking the account's login.
session/
*.session

# Runtime-generated persistent state (message cache, per-feature JSON
# stores, media pulled down for anti-delete, plugin cache, etc.)
database/*.json
!database/.gitkeep
database/media-store/
plugins/

# Secrets / environment
.env
.env.*
!.env.example
config.local.json

# Logs
*.log
npm-debug.log*
logs/

# Temp / cache directories created at runtime
temp/
tmp/
.cache/

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
